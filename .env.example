# Frontend
VITE_SUPABASE_URL=https://czbvvplfwenxzumhvmcl.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN6YnZ2cGxmd2VueHp1bWh2bWNsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU5MDM5MDQsImV4cCI6MjEwMTQ3OTkwNH0.V1Br1mQMX5L20NFKFuNMqxYsTJ_R9BhCk-OJAEd73Yg
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=Avora
VITE_DASHBOARD_DATA_MODE=hybrid
# Keep OAuth hidden for zero-config local mode. Set true only after configuring Supabase providers.
VITE_ENABLE_OAUTH=false

# Logging
LOG_LEVEL=info
