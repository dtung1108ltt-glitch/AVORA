# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15

# OpenAI fallback provider (use this instead of Azure OpenAI if preferred)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_ENABLE_DEMO_FALLBACK=true
AI_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_RETRY_BASE_MS=700
AI_PROVIDER_RETRY_MAX_MS=2500

# OpenRouter (phương án B — 1 provider dùng chung cho cả LLM và Embedding model, tránh xung đột nhiều key/rate-limit)
# Lấy API key tại https://openrouter.ai/keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-or-your-openrouter-key
# OPENAI_MODEL=qwen/qwen3-8b:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# EMBEDDING_MODEL dùng chung OPENAI_API_KEY + OPENAI_BASE_URL ở trên (xem embedding.service.ts)

# Groq provider (optional, fast hosted inference)
# Create a key at https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk-your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local AI provider (optional, no cloud key; requires Ollama installed and running)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Azure Speech
AZURE_SPEECH_KEY=your-speech-key-here
AZURE_SPEECH_REGION=eastus

# Azure Cosmos DB
COSMOS_DB_CONNECTION_STRING=your-cosmos-connection-string
COSMOS_DB_NAME=ai4a

# Azure SQL
AZURE_SQL_CONNECTION_STRING=your-sql-connection-string

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=ai4a-uploads

# Azure Redis Cache
AZURE_REDIS_CONNECTION_STRING=rediss://:your-password@your-cache.redis.cache.windows.net:6380
REDIS_URL=rediss://:your-password@your-cache.redis.cache.windows.net:6380
RATE_LIMIT_STORE=memory

# Azure AD B2C (Authentication)
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URI=http://localhost:3000

# Application
NODE_ENV=development
PORT=4000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
DEMO_DATA_FILE=./data/demo-db.json
API_DATA_MODE=demo
AUTH_PASSWORD_RESET_DRY_RUN=true
API_RATE_LIMIT_MAX=600
AI_RATE_LIMIT_MAX=30
AI_ACTION_RATE_LIMIT_MAX=20
DEBUG_API_REQUESTS=false

# Partner inquiry email
# In local demos, leave RESEND_API_KEY empty and set PARTNER_INQUIRY_DRY_RUN=true.
RESEND_API_KEY=
PARTNER_EMAIL_TO=partnerships@example.com
PARTNER_INQUIRY_DRY_RUN=true

# Interview speech-to-text (OpenAI Whisper)
# Optional for local demos. Required only when the microphone should transcribe real speech.
# Dùng chung OPENAI_API_KEY đã khai báo ở phần AI provider phía trên.
SPEECH_TO_TEXT_MODEL=whisper-1
# Mã ngôn ngữ ISO-639-1, ví dụ "vi" cho tiếng Việt. Để trống để Whisper tự nhận diện.
SPEECH_TO_TEXT_LANGUAGE_CODE=
SPEECH_TO_TEXT_MAX_AUDIO_BYTES=10485760

# Text-to-speech (Google Cloud TTS) — sẽ dùng ở bước kế tiếp của Giai đoạn 1
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=vi-VN-Wavenet-A

# Supabase (Authentication)
SUPABASE_URL=https://czbvvplfwenxzumhvmcl.supabase.co
